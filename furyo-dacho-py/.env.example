# アプリケーション設定
APP_ENV=production
APP_URL=https://yourdomain.com
APP_DEBUG=false

# 暗号化キー（64文字の16進数。python3 -c "import secrets; print(secrets.token_hex(32))" で生成）
# ※ PHP版から移行する場合は、PHP版の config/.env の値をそのまま使うこと（変えると保存済みの画像が開けなくなる）
ENCRYPTION_KEY=your-32-byte-hex-key-here

# データベース設定（XREAのMySQL設定を入力）
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# アップロードディレクトリ（絶対パス・webroot外。未設定なら storage/uploads）
UPLOAD_DIR=/virtual/your-xrea-account/furyo-dacho-uploads

# リバースプロキシ/ロードバランサ経由で実クライアントIPを記録する場合のみ true。
# 既定（未設定）は安全側で REMOTE_ADDR のみを信頼し、X-Forwarded-For は無視する。
# true の場合も X-Forwarded-For の右端（自前のプロキシが追記した値）から解決する。
# 信頼できるプロキシ配下でない環境で true にするとIP偽装を許すため注意。
# TRUST_PROXY=false
# 自前のプロキシのIP（CIDR可・カンマ区切り）。設定するとそのプロキシ経由の通信だけ信頼する。
# TRUSTED_PROXIES=10.0.0.1,192.168.0.0/24

# 以下は通常は設定不要（未設定なら既定値。注釈は値の後ろに書かず、必ず行頭に書くこと）
# 自動ログアウトまでの秒数
# SESSION_TIMEOUT=900
# セッションの保存先（既定 storage/sessions）
# SESSION_DIR=/virtual/your-xrea-account/furyo-dacho-sessions
# 1ファイルの上限（バイト・既定 50MB）
# MAX_FILE_SIZE=52428800
# 1回の送信全体の上限（バイト・既定 128MB）
# MAX_POST_SIZE=134217728
